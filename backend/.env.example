# ══════════════════════════════════════════════════════════════════
#  Wadjet-Eye AI — Environment Variables Reference  v8.0
#  backend/.env.example
#
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
#  All secrets should ultimately live in HashiCorp Vault (ARCH-002).
# ══════════════════════════════════════════════════════════════════

# ── Phase 0 Security Fixes ────────────────────────────────────────

# FIX-001: CORS allowed origins (comma-separated, no wildcards)
CORS_ALLOWED_ORIGINS=https://wadjet-eye.vercel.app,http://localhost:3000,http://localhost:5173

# FIX-002: JWT secrets (REQUIRED — WS server exits on startup without these)
JWT_SECRET=your-jwt-secret-here-minimum-32-chars
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-dashboard

# FIX-003: Vercel proxy rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
PROXY_RATE_LIMIT_RPM=60
# Development bypass (NEVER set true in production)
SKIP_PROXY_AUTH=false

# FIX-005: Dark web OPSEC — Tor proxy configuration
TOR_PROXY_HOST=tor
TOR_SOCKS_PORTS=9050,9051,9052
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASS=your-tor-control-password
DARKWEB_ENABLED=true
DARKWEB_ORG_KEYWORDS=YourOrg,YourDomain,yourorg.com
# Encrypted site list (AES-256-GCM, base64) — generate via encrypt-sites.js script
DARKWEB_SITES_ENCRYPTED=
DARKWEB_SITES_KEY=

# FIX-006: Redis-backed distributed profile cache (cross-process eviction)
REDIS_URL=redis://localhost:6379
# Upstash Redis (for serverless / Vercel):
# REDIS_URL=rediss://default:token@instance.upstash.io:6380

# ── Phase 1: AI Security ──────────────────────────────────────────

# AI-FIX-002: Agent configuration
# Note: AUTO_EXECUTE_THRESHOLD is hardcoded to 95 — do NOT override via env
AGENT_LLM_PROVIDER=openai
AGENT_CONSENSUS_REQUIRED=true
AGENT_CONSENSUS_PROVIDER=openai

# AI-FIX-003: RAG document freshness TTL (hours, default: 720 = 30 days)
RAG_DOC_TTL_HOURS=720

# ── Phase 3: Innovation Feature Flags (all off by default) ────────

FEATURE_ADVERSARY_DNA=false
FEATURE_KILL_CHAIN_FORECAST=false
FEATURE_MULTILINGUAL_DW=false
FEATURE_CYBER_TERRAIN=false

# DeepL API (required when FEATURE_MULTILINGUAL_DW=true)
DEEPL_API_KEY=your-deepl-api-key

# ── Phase 4: Infrastructure ───────────────────────────────────────

# Kafka IOC pipeline (ARCH-003)
KAFKA_BROKER=localhost:9092
KAFKA_IOC_TOPIC=ioc.raw
KAFKA_IOC_ENRICHED_TOPIC=ioc.enriched
KAFKA_ALERT_TOPIC=alert.generated

# HashiCorp Vault (ARCH-002)
VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=your-approle-role-id
VAULT_SECRET_ID=your-approle-secret-id
# Static token (development only — use AppRole in production):
# VAULT_TOKEN=hvs.your-vault-token
VAULT_KV_MOUNT=secret
VAULT_SECRET_PATH=wadjet-eye
VAULT_CACHE_TTL=300000

# Prometheus / Grafana (INFRA-003)
METRICS_PATH=/metrics
PROMETHEUS_SECRET=your-prometheus-scrape-secret
DARKWEB_HEALTH_PORT=8081

# ── Core Services (unchanged) ─────────────────────────────────────

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

OPENAI_API_KEY=sk-your-openai-key
CLAUDE_API_KEY=sk-ant-your-claude-key
GEMINI_API_KEY=your-gemini-key

VT_API_KEY=your-virustotal-key
ABUSEIPDB_API_KEY=your-abuseipdb-key
OTX_API_KEY=your-otx-key
URLHAUS_API_KEY=your-urlhaus-key
NVD_API_KEY=your-nvd-api-key

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

PINECONE_API_KEY=your-pinecone-key
PINECONE_HOST=your-index.svc.us-east1-gcp.pinecone.io
PINECONE_INDEX=wadjet-eye
WEAVIATE_URL=http://weaviate:8080

RAKAY_SERVICE_KEY=minimum-32-char-internal-service-key
PASTEBIN_API_KEY=your-pastebin-scraping-key

NODE_ENV=development
PORT=4000
